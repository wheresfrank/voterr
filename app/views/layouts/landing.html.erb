<!DOCTYPE html>
<html lang="en" class="landing-html">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= content_for?(:title) ? yield(:title) : "Voterr — Movie nights from your Plex library" %></title>

  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Sign in with Plex, start a voting session, and pick a movie everyone agrees on—using only titles from your library." %>">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" referrerpolicy="no-referrer">
  <style>
    .material-symbols-outlined {
      font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
    }
    .material-symbols-outlined.landing-ms--fill {
      font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
    }
  </style>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "landing", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <%= favicon_link_tag asset_path("favicon.png") %>

  <link rel="canonical" href="<%= request.original_url %>">

  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Voterr — Movie nights from your Plex library" %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Sign in with Plex, start a voting session, and pick a movie everyone agrees on—using only titles from your library." %>">
  <meta property="og:image" content="<%= asset_url("voterr_logo.svg") %>">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= request.original_url %>">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Voterr — Movie nights from your Plex library" %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "Sign in with Plex, start a voting session, and pick a movie everyone agrees on—using only titles from your library." %>">
  <meta name="twitter:image" content="<%= asset_url("voterr_logo.svg") %>">

  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "WebApplication",
    "name" => "Voterr",
    "description" => "Sign in with Plex, start a voting session, and pick a movie everyone agrees on—using only titles from your library.",
    "url" => request.base_url,
    "applicationCategory" => "EntertainmentApplication",
    "operatingSystem" => "Web"
  }.to_json) %>
  </script>

  <%= yield(:head) %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4R9KKJEZ70"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4R9KKJEZ70');
  </script>
</head>
<body class="landing-body">
  <%= render "layouts/landing_navbar" %>
  <% flash.each do |name, message| %>
    <% next if message.blank? %>
    <div class="landing-flash container is-fluid px-4">
      <div class="notification <%= name.to_s == "notice" ? "is-success" : "is-danger" %> is-light my-3">
        <%= message %>
      </div>
    </div>
  <% end %>
  <%= yield %>
</body>
</html>
