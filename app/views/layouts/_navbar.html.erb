<nav class="app-navbar" role="navigation" aria-label="main navigation" data-controller="navbar">
  <div class="app-navbar__inner">
    <%= link_to "Voterr", root_path, class: "app-wordmark", aria: { label: "Voterr dashboard" } %>
    <a role="button" class="app-navbar__burger" aria-label="menu" aria-expanded="false" data-action="click->navbar#toggleMenu" data-navbar-target="burger">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
    <div id="navbar" class="app-navbar__menu" data-navbar-target="menu">
      <%= link_to "Dashboard", sessions_path, class: class_names("app-navbar__link", "is-active": controller_name == "sessions") %>
      <%= link_to "About", about_path, class: class_names("app-navbar__link", "is-active": controller_name == "pages" && action_name == "about") %>
      <% if current_user %>
        <span class="app-navbar__user"><%= current_user.name %></span>
        <%= button_to "Log out", logout_path, method: :delete, data: { turbo: false, turbo_confirm: "Are you sure you want to log out?" }, class: "app-button app-button--quiet app-button--small" %>
      <% end %>
    </div>
  </div>
</nav>
