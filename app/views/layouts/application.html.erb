<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= content_for?(:title) ? yield(:title) : SeoHelper::DEFAULT_TITLE %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : SeoHelper::DEFAULT_DESCRIPTION %>">
  <meta name="robots" content="noindex, nofollow">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <%= favicon_link_tag asset_path("favicon.png") %>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Voterr">
  <meta property="og:url" content="<%= SeoHelper::CANONICAL_ORIGIN %>/">
  <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : SeoHelper::DEFAULT_TITLE %>">
  <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : SeoHelper::DEFAULT_DESCRIPTION %>">
  <meta property="og:image" content="<%= seo_image_url %>">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="<%= SeoHelper::OG_IMAGE_WIDTH %>">
  <meta property="og:image:height" content="<%= SeoHelper::OG_IMAGE_HEIGHT %>">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : SeoHelper::DEFAULT_TITLE %>">
  <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : SeoHelper::DEFAULT_DESCRIPTION %>">
  <meta name="twitter:image" content="<%= seo_image_url %>">

  <%= yield(:head) %>

  <%# Privacy-friendly analytics, opt-in for the official deployment only.
      Self-hosters get no tracking unless they set these env vars to their own
      Plausible instance. See README "Analytics". %>
  <% if ENV["PLAUSIBLE_SCRIPT_SRC"].present? && ENV["PLAUSIBLE_DOMAIN"].present? %>
    <script defer data-domain="<%= ENV["PLAUSIBLE_DOMAIN"] %>" src="<%= ENV["PLAUSIBLE_SCRIPT_SRC"] %>"></script>
  <% end %>
</head>
  <body class="app-body">
    <%= render "layouts/navbar" %>
    <% flash.each do |name, message| %>
      <% next if message.blank? %>
      <div class="app-flash app-flash--<%= name == "notice" ? "success" : "error" %>" role="status" data-controller="flash">
        <span><%= message %></span>
        <button type="button" class="app-flash__close" data-action="flash#dismiss" aria-label="Dismiss notification">&times;</button>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
