<header class="landing-navbar">
  <div class="landing-navbar-inner container is-max-widescreen">
    <%= link_to root_path, class: "landing-wordmark" do %>
      Voterr
    <% end %>
    <nav class="landing-navbar-links" aria-label="Primary">
      <%= link_to "How it works",
            root_path(anchor: "how-it-works"),
            class: class_names("landing-navbar-link", "landing-link-desktop", "landing-navbar-link--active": controller_name == "pages" && action_name == "home") %>
      <%= link_to "Compare",
            compare_path,
            class: class_names("landing-navbar-link", "landing-navbar-link--active": controller_name == "pages" && action_name == "compare") %>
      <%= link_to "About",
            about_path,
            class: class_names("landing-navbar-link", "landing-navbar-link--active": controller_name == "pages" && action_name == "about") %>
    </nav>
    <div class="landing-navbar-actions">
      <% if logged_in? %>
        <%= link_to "Dashboard", sessions_path, class: "button landing-button-primary landing-navbar-cta" %>
      <% else %>
        <%= link_to "Log in with Plex", new_plex_auth_path, class: "button landing-button-primary landing-navbar-cta" %>
      <% end %>
    </div>
  </div>
</header>
