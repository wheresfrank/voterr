<% content_for :title, "Log in with Plex — Voterr" %>
<% content_for :description, "Sign in with Plex to host a movie-night vote on Voterr. Guests you invite will join by name and will not need a Plex login." %>
<% content_for :robots, "noindex, nofollow" %>

<main
  id="top"
  class="landing-main landing-login"
  data-controller="plex-auth"
  data-plex-auth-plex-base-url-value="https://plex.tv"
  data-plex-auth-plex-product-value="<%= @plex_product %>"
  data-plex-auth-plex-version-value="<%= @plex_version %>"
  data-plex-auth-client-id-value="<%= @client_id %>"
  data-plex-auth-browser-name-value="<%= @browser_name %>"
  data-plex-auth-browser-version-value="<%= @browser_version %>"
  data-plex-auth-device-value="<%= @device %>"
  data-plex-auth-device-name-value="<%= @device_name %>"
  data-plex-auth-callback-url-value="<%= @callback_url %>"
  data-plex-auth-redirect-url-value="<%= sessions_path %>"
>
  <section class="landing-hero landing-hero--short" aria-labelledby="login-heading">
    <div class="landing-hero-backdrop" aria-hidden="true">
      <div class="landing-hero-scrim"></div>
    </div>
    <div class="landing-hero-inner">
      <h1 id="login-heading" class="landing-headline landing-hero-title mb-5">
        Log in with<br>
        <span class="landing-accent">Plex</span>
      </h1>
      <p class="landing-hero-tagline landing-hero-tagline--light">
        Hosts sign in with Plex OAuth so Voterr can load movies from your library.
        Friends you invite still join by name — they never need a Plex login.
      </p>
      <div class="landing-cta-row">
        <button type="button" class="button landing-button-primary" data-action="click->plex-auth#initiate">
          Log in with Plex
        </button>
        <%= link_to "Back to Voterr", root_path, class: "button landing-button-ghost" %>
      </div>
      <p class="landing-status" data-plex-auth-target="status" aria-live="polite"></p>
      <noscript>
        <p class="landing-text-muted">Plex sign-in needs JavaScript so Voterr can open the Plex authorization window.</p>
      </noscript>
    </div>
  </section>
</main>
