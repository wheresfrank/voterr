<section class="app-card app-lobby__roster">
  <div class="app-section-title">
    <div><p class="app-card__kicker">The guest list</p><h2><%= pluralize(session.voters.count, "person") %> ready</h2></div>
    <span class="app-status-pill">Waiting</span>
  </div>
  <%= turbo_frame_tag "voters-session-#{session.id}" do %>
    <%= render "sessions/voters", session: session, host_controls: host_controls %>
  <% end %>
</section>