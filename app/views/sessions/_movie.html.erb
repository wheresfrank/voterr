<%= turbo_frame_tag "movie_#{movie.plex_id}" do %>
  <article class="app-movie-card <%= 'app-movie-card--winner' if session.winner.present? %>">
    <div class="app-movie-card__poster">
      <div class="app-poster">
        <% if poster_path(movie).present? %>
          <%= image_tag(poster_path(movie)) %>
        <% else %>
          <%= render 'sessions/poster_placeholder' %>
        <% end %>
      </div>
    </div>
    <div class="app-movie-card__content">
      <div>
        <p class="app-movie-card__label"><%= session.winner.present? ? "Tonight's pick" : "Your next pick" %></p>
        <h2><%= movie.title %></h2>
        <p class="app-movie-card__meta"><%= movie[:year] %><span>•</span><%= duration(movie) %><span>•</span><%= movie.content_rating || 'Not rated' %></p>
        <p class="app-movie-card__genres"><%= genres(movie) %></p>
        <div class="app-ratings">
          <div><span class="rating-icon"><%= rating_icon(movie) %></span><strong><%= rating_percent(movie.rating) %></strong><small>Critics</small></div>
          <div><span class="rating-icon"><%= audience_rating_icon(movie) %></span><strong><%= rating_percent(movie.audience_rating) %></strong><small>Audience</small></div>
        </div>
        <% if movie.tagline.present? %><p class="app-movie-card__tagline">“<%= movie.tagline %>”</p><% end %>
        <p class="app-movie-card__summary"><%= truncate(movie.summary, length: 400, omission: '...') %></p>
      </div>
      <div class="app-movie-card__actions">
        <% if session.winner.present? %>
            <%= link_to "Open in Plex ↗", "https://app.plex.tv/desktop/#!/server/#{session.user.plex_server_id}/details?key=/library/metadata/#{session.winner.plex_id}", target: "_blank", class: "app-button app-button--primary app-button--wide" if current_user %>
        <% else %>
          <%= render 'sessions/vote_buttons', session: session, movie: movie %>
        <% end %>
      </div>
    </div>
  </article>
<% end %>
