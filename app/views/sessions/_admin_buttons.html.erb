<%= link_to "Back to dashboard", sessions_path, class: "app-button app-button--quiet", data: { turbo: false } %>
<%= form_with url: session_path(session), method: :delete, data: { turbo: false, confirm: "Are you sure you want to delete this session?" }, local: true do |form| %>
    <%= form.submit "Delete session", class: "app-button app-button--danger" %>
<% end %>
