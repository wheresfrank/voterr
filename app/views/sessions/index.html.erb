<main class="app-page app-dashboard">
  <section class="app-page__heading">
    <p class="app-eyebrow">Movie night headquarters</p>
    <h1>Pick the perfect movie,<br><span>together.</span></h1>
    <p>Start a room, share the link, and let the group find the one movie everyone wants to watch.</p>
  </section>
  <div class="app-dashboard__grid">
    <section class="app-card app-card--create">
      <p class="app-card__kicker">New session</p>
      <h2>What are we watching?</h2>
      <%= render "form", session: @session %>
      <% if @sessions.in_progress.any? %>
        <div class="app-active-sessions">
          <div class="app-section-title"><h2>In progress</h2><span><%= @sessions.in_progress.count %> live</span></div>
          <ul class="app-session-list">
            <% @sessions.in_progress.each do |session| %>
              <li class="app-session-list__item">
                <%= link_to session_path(session), class: "app-session-list__link" do %>
                  <span class="app-live-dot"></span><span><strong><%= session.session_name %></strong><small><%= pluralize(session.voters.count, "voter") %> · <%= pluralize(session.votes.count, "vote") %></small></span><span aria-hidden="true">→</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
    <section class="app-card app-card--winners">
      <div class="app-section-title"><div><p class="app-card__kicker">The hall of fame</p><h2>Recent winners</h2></div></div>
      <% if @sessions.recent_winners.any? %>
        <div class="app-poster-grid">
          <% @sessions.recent_winners.each do |session| %>
            <div class="app-winner-card">
              <% if poster_path(session.winner).present? %>
                <%= image_tag(poster_path(session.winner), alt: session.winner.title) %>
              <% else %>
                <%= render 'sessions/winner_poster_placeholder' %>
              <% end %>
              <div class="app-winner-card__caption"><strong><%= session.winner.title %></strong><span><%= session.session_name %></span></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="app-empty-state"><span>✦</span><h3>Your winners will live here</h3><p>Start a session and make the first great choice.</p></div>
      <% end %>
    </section>
  </div>
</main>
