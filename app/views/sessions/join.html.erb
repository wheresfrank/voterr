<main class="app-join-page">
    <div class="app-join-card">
      <%= link_to "Voterr", root_path, class: "app-wordmark" %>
      <p class="app-eyebrow">You’re invited</p>
      <h1>Movie night is<br>about to begin.</h1>
      <p>Enter your name to help <strong><%= @session.user.name %></strong> choose what to watch.</p>
      <%= form_with url: guest_vote_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <%= hidden_field_tag :token, params[:token] %>
        <div class="app-field">
          <%= text_field_tag :guest_name, nil, class: "app-input" , placeholder: "Your name" %>
        </div>
        <div>
          <%= f.submit "Join the room", class: "app-button app-button--primary app-button--wide" %>
        </div>
      <% end %>
      <p class="app-join-card__footnote">No Plex account needed. Just bring your opinions.</p>
    </div>
</main>
