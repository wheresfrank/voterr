<section class="app-lobby">
  <div class="app-lobby__heading">
    <p class="app-eyebrow">Lobby open</p>
    <h1><%= session.session_name %></h1>
    <p>Invite everyone before voting starts. Starting the vote locks this guest list, so nobody can join late or change the winning threshold.</p>
  </div>

  <div class="app-lobby__grid">
    <%= turbo_frame_tag "lobby_roster_#{session.id}" do %>
      <%= render "sessions/lobby_roster", session: session, host_controls: current_user.present? %>
    <% end %>

    <%= turbo_frame_tag "lobby_controls_#{session.id}" do %>
      <%= render "sessions/lobby_controls", session: session, host_controls: current_user.present? %>
    <% end %>
  </div>
</section>